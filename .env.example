# Example Environment Variables
# Copy this file to .env and fill in your actual values

# Database
ATLASDB_URL=mongodb+srv://username:password@cluster.mongodb.net/dbname

# Session Secret
SECRET=your_random_secret_key_here_change_this

# Mapbox Token (for location maps)
MAP_TOKEN=your_mapbox_public_token_here

# Stripe API Keys
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_PUBLIC_KEY=your_stripe_secret_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Stripe Webhook Secret
# Get this from https://dashboard.stripe.com/webhooks after creating endpoint
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Cloudinary (for image uploads)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Environment
NODE_ENV=development

# Stripe Test Cards (for testing only):
# Success: 4242 4242 4242 4242
# Decline: 4000 0000 0000 0002
# 3D Secure: 4000 0025 0000 3155
# Any expiry date in future (e.g., 12/25)
# Any 3-digit CVC
