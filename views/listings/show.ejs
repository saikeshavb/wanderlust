<% layout("/layouts/boilerplate.ejs") %>
<br>
<div class="row">
    <div class="col col-8 offset-2">
        <body>
            <h3><%=listing.title%></h3>
            <div class="card listing-card show-img col-6 mb-0">
                <img src="<%=listing.image.url%>" class="card-img-top show-img" alt="...">
                <div class="card-body">
                  <p class="card-text">
                    <b>Owner:</b><i><%=listing.owner.username%></i>
                    <br/>
                    <%= listing.description %><br>
                    &#8377; <%= listing.price.toLocaleString("en-IN") %><br>
                    <%= listing.location %><br>
                    <%= listing.country%>
                </p>
                </div>
            </div>
            <%if(currUser && currUser._id.equals(listing.owner._id)){%>
                <div class="btns">
                    <a href="/listings/<%=listing._id%>/edit" class="btn edit-btn">Edit</a>
                    <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
                        <button class="btn btn-dark">Delete</button>
                    </form>
                </div>
            <%}%>

            <!-- Booking Section -->
            <%if(!currUser || !currUser._id.equals(listing.owner._id)){%>
                <div class="card mt-4 mb-3" style="border: 2px solid #28a745;">
                    <div class="card-body">
                        <h5 class="card-title text-success">Book Your Stay</h5>
                        <p class="card-text">&#8377; <strong><%= listing.price.toLocaleString("en-IN") %> per night</strong></p>
                        
                        <form id="bookingForm" class="needs-validation" novalidate>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="checkInDate" class="form-label">Check-in Date</label>
                                    <input type="date" class="form-control" id="checkInDate" name="checkInDate" required>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="checkOutDate" class="form-label">Check-out Date</label>
                                    <input type="date" class="form-control" id="checkOutDate" name="checkOutDate" required>
                                </div>
                            </div>

                            <div class="mb-3">
                                <p class="text-muted">
                                    <strong>Number of Nights:</strong> <span id="numberOfNights">0</span>
                                </p>
                                <p class="text-success">
                                    <strong>Total Price:</strong> &#8377; <span id="totalPrice">0</span>
                                </p>
                            </div>

                            <%if(currUser){%>
                                <button type="submit" class="btn btn-success btn-lg w-100">
                                    <i class="fas fa-calendar-check"></i> Proceed to Book
                                </button>
                            <%} else {%>
                                <a href="/login" class="btn btn-success btn-lg w-100">
                                    <i class="fas fa-sign-in-alt"></i> Login to Book
                                </a>
                            <%}%>
                        </form>
                    </div>
                </div>
            <%}%>

            <hr/>
            <div class="mb-3 mt-3">
                <h4>Leave a Review!</h4>
                <form method="POST" action="/listings/<%=listing._id%>/reviews" class="needs-validation" novalidate>
                    <fieldset class="starability-grow">
                        <!-- <label for="rating" class="form-label">Rating</label> -->
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                     </fieldset>
                    <div>
                        <label for="comment" class="form-label">Comments</label>
                        <textarea id="rating" cols="30" rows="5" name="review[comment]" class="form-control" required></textarea>
                        <div class="invalid-feedback">please enter comments</div>
                    </div>
                    <button class="btn btn-outline-dark mt-3">Submit</button>
                </form>
                                
            </div>
            <hr/>
            <%if(listing.reviews.length>0){%>
                <div class="row">
                    <h4>All Reviews</h4>
                    <% for(review of listing.reviews){%>
                        <div class="card col-5 mt-2 ms-2" >
                            <div class="card-body">
                                <h5 class="card-title"></h5>
                                <p class="card-text"><%=review.comment%></p>
                                <p class="starability-result card-text" data-rating=<%=review.rating%>></p>
                            </div>
                        </div>
                        <% }%>
                </div>
            <%}%>
            <br>
        </body>
    </div>
    <div class="col col-8 offset-2">
        <h3>Where you'll find us!</h3>
        <div id='map'></div>
    </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/js/all.min.js"></script>
<script>
    let mapToken="<%=process.env.MAP_TOKEN%>";
    console.log(mapToken);
	mapboxgl.accessToken =mapToken;
    const map = new mapboxgl.Map({
        container: "map",
        style: "mapbox://styles/mapbox/streets-v12",
        zoom: 9,
        center: [78.4772, 17.4065]
    });

    // Booking form calculations
    const checkInInput = document.getElementById('checkInDate');
    const checkOutInput = document.getElementById('checkOutDate');
    const bookingForm = document.getElementById('bookingForm');

    const pricePerNight = Number("<%= listing.price %>");

    function calculatePrice() {
        if (checkInInput.value && checkOutInput.value) {
            const checkIn = new Date(checkInInput.value);
            const checkOut = new Date(checkOutInput.value);
            
            if (checkOut > checkIn) {
                const nights = Math.ceil((checkOut - checkIn) / (1000 * 60 * 60 * 24));
                const totalPrice = nights * pricePerNight;
                
                document.getElementById('numberOfNights').textContent = nights;
                document.getElementById('totalPrice').textContent = totalPrice.toLocaleString("en-IN");
            }
        }
    }

    checkInInput.addEventListener('change', calculatePrice);
    checkOutInput.addEventListener('change', calculatePrice);

    // Set minimum date to today
    const today = new Date().toISOString().split('T')[0];
    checkInInput.setAttribute('min', today);
    checkOutInput.setAttribute('min', today);

    bookingForm.addEventListener('submit', function(e) {
        e.preventDefault();
        
        if (!checkInInput.value || !checkOutInput.value) {
            alert('Please select both check-in and check-out dates');
            return;
        }

        const checkIn = new Date(checkInInput.value);
        const checkOut = new Date(checkOutInput.value);

        if (checkOut <= checkIn) {
            alert('Check-out date must be after check-in date');
            return;
        }

        const nights = Math.ceil((checkOut - checkIn) / (1000 * 60 * 60 * 24));
        const totalPrice = nights * pricePerNight;

        // Redirect to checkout
        window.location.href = `/payment/<%= listing._id %>/checkout?checkInDate=${checkInInput.value}&checkOutDate=${checkOutInput.value}&numberOfNights=${nights}`;
    });
</script>
